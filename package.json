{
  "name": "weavision-desktop",
  "version": "0.2.0",
  "description": "织见 Weavision - 思维关系板桌面应用",
  "main": "桌面应用/main.cjs",
  "author": "Weavision",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --dir",
    "package:dir": "electron-builder --dir",
    "package:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.weavision.desktop",
    "productName": "织见 Weavision",
    "directories": {
      "output": "发行版"
    },
    "files": [
      "桌面应用/**/*",
      "2-新版本及其素材/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "织见-Weavision-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}

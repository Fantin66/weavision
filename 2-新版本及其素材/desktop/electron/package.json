{
  "name": "zhijian-weavision",
  "version": "0.5.2",
  "description": "织见 · 思维关系板 — Desktop App (I9)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:portable": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.weavision.zhijian",
    "productName": "织见",
    "copyright": "源代码公开 · 免费 · 禁止商用 © 2026 织见 Weavision",
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../../织见-思维关系板-I9.html",
        "to": "index.html"
      },
      {
        "from": "../../i6",
        "to": "i6",
        "filter": [
          "**/*",
          "!**/.mimosa/**"
        ]
      },
      {
        "from": "../../g10",
        "to": "g10",
        "filter": [
          "assets/logos/**"
        ]
      },
      {
        "from": "icons",
        "to": "icons",
        "filter": [
          "*.png",
          "*.ico"
        ]
      }
    ],
    "directories": {
      "output": "../../发行版/I9"
    },
    "fileAssociations": [
      {
        "ext": "fantin",
        "name": "织见画板",
        "description": "织见思维关系板导出文件",
        "icon": "icons/fantin-2.ico",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "织见"
    },
    "portable": {
      "artifactName": "织见-便携版-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "level": "^10.0.0"
  }
}
